{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2025"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["rulesets/**/*.ts", "scripts/**/*.ts", "src/**/*.ts", "test/**/*.ts"]
}
